{
  "$schema": "https://opencode.ai/config.json",
  "model": "redhat/rits/deepseek-ai/DeepSeek-V4.1-Flash-1017",
  "providers": {
    "redhat": {
      "name": "Red Hat",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (EnMaaS)",
          "package": "@opencode/ai/providers/openai-compatible/responses"
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (EnMaaS)",
          "package": "@opencode/ai/providers/openai-compatible/responses"
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (EnMaaS)",
          "package": "@opencode/ai/providers/anthropic-compatible",
          "headers": {
            "anthropic-version": "2023-06-01"
          }
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5 (EnMaaS)",
          "package": "@opencode/ai/providers/anthropic-compatible",
          "headers": {
            "anthropic-version": "2023-06-01"
          }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (EnMaaS)",
          "package": "@opencode/ai/providers/anthropic-compatible",
          "compatibility": {
            "supportsThinkingBlockBinding": false
          },
          "headers": {
            "anthropic-version": "2023-06-01"
          }
        },
        "rits/zai-org/glm-5-3": {
          "name": "GLM-5.3 (EnMaaS)",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash (EnMaaS)"
        }
      },
      "env": [
        "ENMAAS_KEY"
      ]
    }
  },
  "skills": [
    "~/.claude/plugins/marketplaces/hyperfleet-claude-plugins/hyperfleet-devtools/skills"
  ]
}
