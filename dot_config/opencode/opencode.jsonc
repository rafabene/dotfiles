{
  "$schema": "https://opencode.ai/config.json",
  // Contexto global carregado em todas as sessões
  "contextoGlobal": {
    "desenvolvedor": "rafael",
    "timezone": "America/Sao_Paulo",
    "linguagemPreferida": "pt-BR",
    "diretorioTrabalho": "/Users/rafael/projetos/OCM-new"
  },
  // Instruções pessoais do desenvolvedor (de ~/.claude/CLAUDE.md)
  "instrucoesRafael": {
    "commits": {
      "nuncaUseCoAuthoredBy": true,
      "sempreIncluaIdDoTicket": true,
      "mantenha1CommitOuFacaSquash": true,
      "sempreAssineCommits": true,
      "formato": "HYPERFLEET-XXX - type: subject (ou seu ticket específico)"
    },
    "github": {
      "useSempreGithubCli": true,
      "resposataARevisionComments": "Use 'gh api repos/{owner}/{repo}/pulls/{pr}/comments/{comment_id}/replies' para responder dentro do thread",
      "nuncaUseGhPrCommentParaRespostasDeReview": true
    },
    "jira": {
      "useSempreJiraCli": true,
      "nuncaUseHYPERFLEET-XXXNoTituloDeTickets": true
    },
    "markdown": {
      "useFencedCodeBlockComLanguageIdentifier": true,
      "nuncaUsePseudoHeadingsComBold": true,
      "useHeadingsAdequados": true,
      "semprefecheCodeBlocks": true,
      "eviteErrosMD040": true
    },
    "codigo": {
      "semprePerguanteAntesDeassumir": true,
      "exemplos": [
        "Qual o nome do pacote que devo usar para o go.mod?",
        "Qual o banco de dados que será usado?",
        "Qual a estrutura esperada?"
      ],
      "testarTambem": [
        "testes de integração",
        "testes e2e",
        "não apenas testes unitários"
      ]
    },
    "interacoes": {
      "quandoUserColarComentario": "Responda-o logo abaixo",
      "nuncaUse": "Generated with Claude Code - ou Co-Authored-By nos commits",
      "textoParaCopiarColar": "Deixe em texto puro sem caracteres ▎ em cada linha"
    }
  },
  // Instruções para agentes de IA em todas as sessões
  "instrucoes": {
    "estiloCodigo": {
      "comentarios": "Combine com a densidade de comentários ao redor. Adicione comentários apenas onde o comportamento não é óbvio",
      "imports": "Agrupe por: biblioteca padrão, terceiros, local. Ordene alfabeticamente dentro de grupos",
      "nomenclatura": "Use nomes descritivos. Evite letras únicas exceto contadores de loop e matemática",
      "comprimentoMaximoLinha": 100
    },
    "git": {
      "formatoCommit": "Mantenha mensagens concisas; use conventional commits (feat:, fix:, docs:, etc)",
      "branches": "Branches de feature usam ticket JIRA como prefixo (ex: HYPERFLEET-1571-nome-feature)",
      "consolidacao": "Consolide commits relacionados antes de fazer merge"
    },
    "revisao": {
      "pullRequests": "Execute sempre validação antes de fazer push (make ci-validate ou equivalente)",
      "testes": "Execute testes localmente antes de enviar para revisão",
      "documentacao": "Atualize README/ADRs ao adicionar features"
    }
  },
  // Ferramentas e preferências padrão
  "ferramentas": {
    "shell": {
      "preferirBash": false,
      "usarAliases": true
    },
    "git": {
      "autoCommit": false,
      "autoForcePush": false,
      "sempreAssinar": true
    },
    "cli": {
      "github": "sempre que possível",
      "jira": "sempre que possível"
    }
  },
  // Padrões de sessão
  "sessoes": {
    "salvarRastreamentosAutomaticamente": true,
    "verbosidade": "concisa",
    "perguanteAntesDeassumir": true
  }
}